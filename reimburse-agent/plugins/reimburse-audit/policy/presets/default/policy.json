{
  "plugin_version": "1.0.0",
  "policy": {
    "name": "星河科技有限公司差旅与费用报销管理办法（模拟版）",
    "version": "mock-1.0",
    "disclaimer": "本制度、公司主体、全部金额阈值、职级与城市分档均为黑客松演示虚构，不代表任何真实企业或监管口径。规则类别参考公开的差旅与报销合规文章，具体数值由本项目自行设定。",
    "scope": "差旅（交通、住宿）与餐饮招待；仅处理增值税电子发票。付款、凭证记账、审批流、真实税局查验不在范围内。",
    "notes": [
      "全部规则逐条独立判定，命中项全部列出；最终结论按 params.decision_priority 取最严格者。",
      "通过、驳回、转人工、退回补材料由规则代码判定，大模型只负责字段抽取和审核意见文字。",
      "业务招待指有外部人员参加的餐饮；仅内部人员的餐饮按工作餐处理。",
      "某字段不可信（置信度不足或两个模型抽取不一致）、所需凭证缺失或所需工具结果缺失时，依赖它的规则不作判定，由 R14 或 R15 兜底，避免用猜测值误驳回。",
      "金额单位：规则表中的阈值为元，系统内部与数据文件中的金额一律为分（整数）。"
    ]
  },
  "params": {
    "company": {
      "name": "星河科技有限公司",
      "tax_id": "91310115MA1FL8X3K0"
    },
    "decision_priority": [
      "reject",
      "manual_review",
      "need_more_info",
      "approve_with_adjustment",
